/* 讨论详情页样式 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 120rpx;
}

/* 帖子卡片 */
.post-card {
  margin-bottom: 20rpx;
}

.post-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.post-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.post-info { flex: 1; }

.post-author {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
}

.post-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.post-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.post-content {
  font-size: 30rpx;
  color: #333;
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.post-actions {
  display: flex;
  gap: 32rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f5f5f5;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #999;
}

.action-item.liked {
  color: #FF6B6B;
}

.action-icon {
  font-size: 32rpx;
}

/* AI 解答区域 - 核心创新功能 */
.ai-answer-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.04) 0%, rgba(118, 75, 162, 0.04) 100%);
  margin-bottom: 20rpx;
}

.ai-answer-trigger {
  cursor: pointer;
}

.ai-answer-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 0;
}

.ai-icon-large {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 700;
  flex-shrink: 0;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
}

.ai-icon-large.spinning {
  animation: spin 1.5s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.ai-btn-text {
  flex: 1;
}

.ai-btn-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #667eea;
}

.ai-btn-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.ai-btn-arrow {
  font-size: 44rpx;
  color: #667eea;
  opacity: 0.5;
}

/* AI 加载状态 */
.ai-loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  gap: 20rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
}

.loading-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #667eea;
  animation: bounce 0.6s infinite alternate;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  to { opacity: 0.3; transform: translateY(-12rpx); }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* AI 解答内容 */
.ai-answer-content {
  padding: 8rpx 0;
}

.ai-answer-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ai-answer-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #667eea;
}

.ai-answer-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.ai-answer-body {
  font-size: 28rpx;
  color: #444;
  line-height: 1.8;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  white-space: pre-wrap;
}

.ai-answer-footer {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}

.ai-tag {
  font-size: 20rpx;
  color: #999;
  background: rgba(102, 126, 234, 0.08);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 评论区 */
.comments-card {
  margin-bottom: 20rpx;
}

.comments-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #4A6CF7;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.comment-body { flex: 1; }

.comment-author {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-content {
  font-size: 28rpx;
  color: #555;
  line-height: 1.5;
  margin-top: 8rpx;
}

.comment-time {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.no-comment {
  text-align: center;
  font-size: 26rpx;
  color: #ccc;
  padding: 40rpx 0;
}

/* 底部评论栏 */
.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #F5F6FA;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
}

.comment-send {
  background: linear-gradient(135deg, #4A6CF7 0%, #6B8CFA 100%);
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 32rpx;
  border-radius: 36rpx;
  font-weight: 500;
}
