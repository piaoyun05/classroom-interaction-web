/* 发帖页样式 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 20rpx;
}

.category-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.category-item {
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F6FA;
  border: 2rpx solid transparent;
}

.category-item.active {
  background: rgba(74, 108, 247, 0.1);
  color: #4A6CF7;
  border-color: #4A6CF7;
}

.title-input {
  font-size: 32rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.content-input {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.6;
  min-height: 240rpx;
  padding: 8rpx 0;
}

.ai-tip-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(102, 126, 234, 0.06);
  border-radius: 12rpx;
}

.ai-badge-mini {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ai-tip-text {
  font-size: 24rpx;
  color: #667eea;
}

.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
}
