/* 发布新内容页样式 */
.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 160rpx;
}

.input-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.title-input {
  font-size: 32rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.content-input {
  width: 100%;
  font-size: 30rpx;
  line-height: 1.6;
  min-height: 200rpx;
  padding: 8rpx 0;
}

/* 选项卡片 */
.option-card {
  padding: 0 28rpx;
}

.option-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
}

.option-label {
  font-size: 30rpx;
  color: #333;
}

.switch {
  width: 84rpx;
  height: 48rpx;
  border-radius: 24rpx;
  background: #ddd;
  position: relative;
  transition: all 0.3s;
}

.switch.on {
  background: #4A6CF7;
}

.switch-dot {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #fff;
  transition: all 0.3s;
}

.switch.on .switch-dot {
  left: 40rpx;
}

/* AI 处理卡片 */
.ai-process-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.04) 0%, rgba(118, 75, 162, 0.04) 100%);
}

.ai-process-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ai-badge-mini {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ai-process-label {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
  color: #667eea;
}

.ai-process-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.ai-loading {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #667eea;
  animation: bounce 0.6s infinite alternate;
}

.loading-dot:nth-child(2) { animation-delay: 0.2s; }
.loading-dot:nth-child(3) { animation-delay: 0.4s; }

@keyframes bounce {
  to { opacity: 0.3; transform: translateY(-8rpx); }
}

.ai-result {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(102, 126, 234, 0.15);
}

.ai-result-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-bottom: 12rpx;
  flex-wrap: wrap;
}

.result-key {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
}

.result-value {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
  flex: 1;
}

.confidence {
  font-size: 22rpx;
  color: #999;
  margin-left: 8rpx;
}

/* 提交按钮 */
.submit-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.submit-btn {
  width: 100%;
  text-align: center;
  padding: 24rpx 0;
}
