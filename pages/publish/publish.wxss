/* 发布列表页样式 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.filter-bar {
  display: flex;
  white-space: nowrap;
  padding: 20rpx 24rpx;
  gap: 16rpx;
  background: #fff;
}

.filter-item {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  background: #F5F6FA;
  flex-shrink: 0;
}

.filter-item.active {
  background: #4A6CF7;
  color: #fff;
}

.ai-tip-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  margin: 0 24rpx;
  background: rgba(102, 126, 234, 0.06);
  border-radius: 12rpx;
}

.ai-badge-mini {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ai-tip-text {
  font-size: 24rpx;
  color: #667eea;
}

.content-list {
  flex: 1;
  padding: 20rpx 24rpx 120rpx;
}

.publish-card {
  position: relative;
}

.publish-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.top-badge {
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.publish-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #bbb;
}

.publish-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.publish-summary {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.publish-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #bbb;
}

/* 悬浮按钮 */
.fab-btn {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4A6CF7 0%, #6B8CFA 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(74, 108, 247, 0.35);
  z-index: 100;
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  line-height: 1;
}
