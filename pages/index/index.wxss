/* 首页样式 */
.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 课程头部 */
.course-header {
  position: relative;
  padding: 0 24rpx 24rpx;
}

.course-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 260rpx;
  background: linear-gradient(135deg, #4A6CF7 0%, #6B8CFA 50%, #8B6CF7 100%);
  border-radius: 0 0 32rpx 32rpx;
}

.course-info {
  position: relative;
  padding: 40rpx 24rpx 20rpx;
}

.course-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
}

.course-meta {
  display: flex;
  gap: 20rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* AI 周报卡片 */
.ai-report-card {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  margin-top: 12rpx;
  box-shadow: 0 4rpx 20rpx rgba(74, 108, 247, 0.12);
}

.ai-report-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.ai-icon-mini {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ai-report-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.ai-report-desc {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.ai-report-arrow {
  font-size: 40rpx;
  color: #ccc;
}

/* Tab 导航 */
.tab-bar {
  display: flex;
  background: #fff;
  padding: 0 16rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
}

.tab-item.active {
  color: #4A6CF7;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: linear-gradient(135deg, #4A6CF7, #6B8CFA);
}

/* 内容滚动区 */
.content-swiper {
  flex: 1;
}

.content-scroll {
  height: 100%;
  padding: 20rpx 24rpx 120rpx;
}

/* 添加按钮 */
.add-btn-wrap {
  margin-bottom: 20rpx;
}

.add-btn {
  width: 100%;
  text-align: center;
  padding: 22rpx 0;
  font-size: 28rpx;
}

/* AI 提示条 */
.ai-tip-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: rgba(102, 126, 234, 0.06);
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.ai-badge-mini {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  flex-shrink: 0;
}

.ai-tip-text {
  font-size: 24rpx;
  color: #667eea;
}

/* 发布卡片 */
.publish-card {
  position: relative;
}

.publish-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.top-badge {
  background: #FF6B6B;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
}

.publish-time {
  margin-left: auto;
  font-size: 22rpx;
  color: #bbb;
}

.publish-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.publish-summary {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.publish-footer {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #bbb;
}

/* 留言卡片 */
.message-card {
  position: relative;
}

.message-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.message-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #4A6CF7;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.message-avatar.anon {
  background: #999;
}

.message-info {
  flex: 1;
}

.message-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.message-type {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.message-status {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.message-status.replied {
  background: #E8F8E8;
  color: #34A853;
}

.message-status.pending {
  background: #FFF3E0;
  color: #FF8800;
}

.message-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.message-reply {
  background: #F8F9FE;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
}

.reply-label {
  font-size: 24rpx;
  color: #4A6CF7;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.reply-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}

.message-time {
  font-size: 22rpx;
  color: #ccc;
  margin-top: 12rpx;
}

/* 讨论卡片 */
.discussion-card {
  position: relative;
}

.discussion-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.discussion-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.discussion-info {
  flex: 1;
}

.discussion-author {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.discussion-time {
  font-size: 22rpx;
  color: #bbb;
  margin-top: 4rpx;
}

.discussion-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.discussion-content-preview {
  font-size: 26rpx;
  color: #888;
  line-height: 1.5;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.discussion-footer {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.footer-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #999;
}

.footer-icon {
  font-size: 28rpx;
}

.ai-answered-badge {
  margin-left: auto;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 88%;
  max-height: 80vh;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  border-bottom: 1rpx solid #eee;
}

.modal-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  padding: 8rpx;
}

.modal-body {
  padding: 28rpx;
  max-height: 60vh;
}

.report-period {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 24rpx;
  text-align: center;
}

.report-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 28rpx;
  padding: 24rpx;
  background: #F8F9FE;
  border-radius: 16rpx;
}

.stat-item {
  text-align: center;
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A6CF7;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.report-section {
  margin-bottom: 28rpx;
}

.report-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #4A6CF7;
}

.report-item {
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
  padding-left: 12rpx;
}

.report-suggestion {
  font-size: 26rpx;
  color: #555;
  line-height: 1.6;
  background: rgba(102, 126, 234, 0.06);
  border-radius: 12rpx;
  padding: 20rpx;
}
