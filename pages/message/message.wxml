<view class="page">
  <!-- 留言说明 -->
  <view class="notice-bar">
    <text class="notice-icon">🔒</text>
    <text class="notice-text">留言仅教师和本人可见，保障提问隐私</text>
  </view>

  <!-- AI 汇总入口（教师端可见） -->
  <view wx:if="{{role === 'teacher'}}" class="ai-summary-entry" bindtap="viewAiSummary">
    <view class="ai-badge-mini">AI</view>
    <view class="entry-info">
      <view class="entry-title">AI学生问题汇总</view>
      <view class="entry-desc">智能分类统计、高频问题TOP10</view>
    </view>
    <view class="entry-arrow">›</view>
  </view>

  <!-- 写留言按钮 -->
  <view class="add-btn-wrap">
    <view class="btn-primary add-btn" bindtap="goNew">
      <text>+ 写留言反馈</text>
    </view>
  </view>

  <!-- 留言列表 -->
  <scroll-view scroll-y class="message-list">
    <view wx:for="{{messages}}" wx:key="id" class="card message-card">
      <view class="message-header">
        <view class="message-avatar {{item.isAnonymous ? 'anon' : ''}}">
          <text>{{item.isAnonymous ? '匿' : item.studentName[0]}}</text>
        </view>
        <view class="message-info">
          <view class="message-name">{{item.studentName}}</view>
          <view class="message-type">{{item.type === 'knowledge' ? '知识点疑问' : item.type === 'suggest' ? '教学建议' : item.type === 'homework' ? '作业问题' : '其他'}}</view>
        </view>
        <view class="message-status {{item.replied ? 'replied' : 'pending'}}">
          {{item.replied ? '已回复' : '待回复'}}
        </view>
      </view>
      <view class="message-content">{{item.content}}</view>
      <view wx:if="{{item.reply}}" class="message-reply">
        <view class="reply-label">教师回复：</view>
        <view class="reply-text">{{item.reply}}</view>
      </view>
      <view class="message-time">{{item.timeText}}</view>
    </view>

    <view wx:if="{{messages.length === 0}}" class="empty-state">
      <view class="empty-text">暂无留言，快给老师写一条留言吧</view>
    </view>
  </scroll-view>
</view>

<!-- AI 汇总弹窗 -->
<view wx:if="{{showAiSummary}}" class="modal-mask" bindtap="closeAiSummary">
  <view class="modal-content" catchtap="stopPropagation">
    <view class="modal-header">
      <view class="modal-title">
        <view class="ai-badge-mini">AI</view>
        <text>学生问题汇总表</text>
      </view>
      <view class="modal-close" bindtap="closeAiSummary">✕</view>
    </view>
    <scroll-view scroll-y class="modal-body">
      <view wx:if="{{aiLoading}}" class="loading-state">
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
        <text class="loading-text">AI正在分析汇总...</text>
      </view>

      <view wx:if="{{aiSummary && !aiLoading}}">
        <view class="summary-stats">
          <view class="stat-item">
            <view class="stat-num">{{aiSummary.total}}</view>
            <view class="stat-label">总留言数</view>
          </view>
          <view class="stat-item">
            <view class="stat-num warn">{{aiSummary.unsolved}}</view>
            <view class="stat-label">待回复</view>
          </view>
        </view>

        <view class="summary-section">
          <view class="summary-section-title">问题类型分布</view>
          <view class="dist-bar">
            <view class="dist-item">
              <text class="dist-label">知识点疑问</text>
              <view class="dist-progress">
                <view class="dist-fill" style="width: {{aiSummary.total ? (aiSummary.typeDistribution.knowledge / aiSummary.total * 100) : 0}}%"></view>
              </view>
              <text class="dist-num">{{aiSummary.typeDistribution.knowledge}}</text>
            </view>
            <view class="dist-item">
              <text class="dist-label">作业问题</text>
              <view class="dist-progress">
                <view class="dist-fill orange" style="width: {{aiSummary.total ? (aiSummary.typeDistribution.homework / aiSummary.total * 100) : 0}}%"></view>
              </view>
              <text class="dist-num">{{aiSummary.typeDistribution.homework}}</text>
            </view>
            <view class="dist-item">
              <text class="dist-label">教学建议</text>
              <view class="dist-progress">
                <view class="dist-fill green" style="width: {{aiSummary.total ? (aiSummary.typeDistribution.suggest / aiSummary.total * 100) : 0}}%"></view>
              </view>
              <text class="dist-num">{{aiSummary.typeDistribution.suggest}}</text>
            </view>
            <view class="dist-item">
              <text class="dist-label">其他</text>
              <view class="dist-progress">
                <view class="dist-fill gray" style="width: {{aiSummary.total ? (aiSummary.typeDistribution.other / aiSummary.total * 100) : 0}}%"></view>
              </view>
              <text class="dist-num">{{aiSummary.typeDistribution.other}}</text>
            </view>
          </view>
        </view>

        <view class="summary-section">
          <view class="summary-section-title">高频问题 TOP3</view>
          <view wx:for="{{aiSummary.topIssues}}" wx:key="rank" class="top-issue-item">
            <view class="rank-badge rank-{{item.rank}}">{{item.rank}}</view>
            <view class="issue-info">
              <view class="issue-question">{{item.question}}</view>
              <view class="issue-meta">{{item.count}}人提及 · {{item.type === 'knowledge' ? '知识点疑问' : item.type === 'homework' ? '作业问题' : item.type === 'suggest' ? '教学建议' : '其他'}}</view>
            </view>
          </view>
        </view>

        <view class="summary-section">
          <view class="summary-section-title">AI总结</view>
          <view class="summary-text">{{aiSummary.summary}}</view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
